# FindDestination Google Play Release Signing Configuration Template
# Copy this file to key.properties on your build VPS (key.properties is git-ignored for security)
#
# Generate your keystore with:
# keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Place upload-keystore.jks in the android/app/ directory or specify its path below.

keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
storeFile=../app/upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
